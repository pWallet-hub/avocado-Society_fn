# ==============================================================
# Avocado Society of Rwanda — Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# ==============================================================

# ----------------------------
# API Configuration
# ----------------------------
VITE_API_BASE_URL=https://applicanion-api.onrender.com
VITE_API_USERS_ENDPOINT=/api/users

# ----------------------------
# Application / Site
# ----------------------------
VITE_SITE_URL=https://avocado-society-rwanda.netlify.app
VITE_APP_NAME=Avocado Society of Rwanda

# ----------------------------
# Environment Mode
# ----------------------------
# Options: development | staging | production
VITE_APP_ENV=development

# ==============================================================
# Avocado Society of Rwanda — Frontend Environment Variables
# ==============================================================
# In Vite, only variables prefixed with VITE_ are exposed to the
# client-side bundle. Never store secrets (private keys, tokens)
# here — this file is bundled into the browser.
# ==============================================================

# ----------------------------
# API Configuration
# ----------------------------
# Base URL of the backend REST API (no trailing slash)
VITE_API_BASE_URL=https://applicanion-api.onrender.com

# The full endpoint used for user / member registration submissions
VITE_API_USERS_ENDPOINT=/api/users

# ----------------------------
# Application / Site
# ----------------------------
# Public URL where this frontend is hosted (used in canonical & OG tags)
VITE_SITE_URL=https://avocado-society-rwanda.netlify.app

# Human-readable name of the application
VITE_APP_NAME=Avocado Society of Rwanda

# ----------------------------
# Environment Mode
# ----------------------------
# Options: development | staging | production
VITE_APP_ENV=production
